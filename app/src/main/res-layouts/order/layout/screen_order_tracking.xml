<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="@dimen/icon_size_lg"
        android:layout_height="@dimen/icon_size_lg"
        android:layout_margin="@dimen/spacing_lg"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Track Order"
        android:textSize="@dimen/text_title_large"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="@dimen/screen_padding" />

    <LinearLayout
        android:id="@+id/ll_timeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <include layout="@layout/component_order_step" android:id="@+id/step_confirmed" />
        <include layout="@layout/component_order_step" android:id="@+id/step_preparing" />
        <include layout="@layout/component_order_step" android:id="@+id/step_delivering" />
        <include layout="@layout/component_order_step" android:id="@+id/step_delivered" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_order_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/ll_timeline" />

</androidx.constraintlayout.widget.ConstraintLayout>
